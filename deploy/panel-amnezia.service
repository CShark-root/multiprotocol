[Unit]
Description=panel - Amnezia containers: status, logs and AmneziaWG clients
After=docker.service
# The panel works without it; it only feeds the Amnezia tab.

[Service]
# Docker's socket is root-only (root-equivalent), so this small helper runs
# as root instead of giving the panel user Docker access. It answers a fixed
# set of requests over /run/panel-amnezia/helper.sock (group panel):
# container status and logs, and adding, removing or renaming AmneziaWG
# clients the way the Amnezia app does (awg0.conf + clientsTable + awg
# syncconf). It never starts, stops, rebuilds or removes a container, and
# keeps a copy of the files before every change in
# /var/lib/panel-amnezia/backups.
ExecStart=/usr/local/bin/panel amnezia-helper
Restart=on-failure
RestartSec=5
RuntimeDirectory=panel-amnezia
RuntimeDirectoryMode=0750
StateDirectory=panel-amnezia
StateDirectoryMode=0700
Group=panel

NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
LockPersonality=true
SystemCallArchitectures=native
MemoryMax=64M

[Install]
WantedBy=multi-user.target
