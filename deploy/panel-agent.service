[Unit]
Description=panel agent - VPN cores on this server, managed by the main panel
After=network-online.target
Wants=network-online.target

[Service]
User=panel
Group=panel
ExecStart=/usr/local/bin/panel agent -data-dir /var/lib/panel
Restart=always
RestartSec=3
StateDirectory=panel
StateDirectoryMode=0700
# Files the panel creates (database, keys, configs) are for its user only.
UMask=0077

# Агент другого сервера. Не root: единственное право — порты ниже 1024
# для ядер (Xray на 443).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
