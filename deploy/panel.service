[Unit]
Description=panel - VPN control panel
After=network-online.target
Wants=network-online.target

[Service]
User=panel
Group=panel
ExecStart=/usr/local/bin/panel -data-dir /var/lib/panel
Restart=on-failure
RestartSec=3
StateDirectory=panel
StateDirectoryMode=0700
# Files the panel creates (database, keys, configs) are for its user only.
UMask=0077

# Not root: binding ports below 1024 needs CAP_NET_BIND_SERVICE. Per-user
# SO_MARK socket tags inherited by Xray and sing-box require CAP_NET_ADMIN.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
NoNewPrivileges=true

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ReadWritePaths=/proc/sys/net/ipv4/conf/all/rp_filter /proc/sys/net/ipv6/conf/all/disable_ipv6
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
